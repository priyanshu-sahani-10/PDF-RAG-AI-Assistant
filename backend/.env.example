# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_TIMEOUT_SECONDS=180

# --- Embeddings (downloaded from HuggingFace on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage (relative paths are resolved from the backend/ folder) ---
DATA_DIR=data
UPLOAD_DIR=uploads
# CHROMA_DIR defaults to <DATA_DIR>/chroma, SQLITE_PATH to <DATA_DIR>/app.db

# --- Upload + chunking ---
MAX_UPLOAD_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=4
# Minimum relevance (1 - cosine distance) for a chunk to be used. Range 0..1.
RELEVANCE_THRESHOLD=0.25

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
